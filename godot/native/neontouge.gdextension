[configuration]

entry_symbol = "neontouge_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

windows.debug.x86_64 = "res://native/bin/libneontouge.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://native/bin/libneontouge.windows.template_release.x86_64.dll"
android.debug.arm64 = "res://native/bin/libneontouge.android.template_debug.arm64.so"
android.release.arm64 = "res://native/bin/libneontouge.android.template_release.arm64.so"
